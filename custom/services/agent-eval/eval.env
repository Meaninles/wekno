# Non-secret resource namespace for the isolated eval worktree.
# Compose loads the repository .env first for local credentials, then this
# file overrides only names, ports and eval-mode switches.
WEKNORA_DOCKER_PREFIX=WeKnora-agent-eval
WEKNORA_DEV_NETWORK_NAME=weknora-agent-eval-network
DB_PORT=15432
REDIS_PORT=16379
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
DOCREADER_PORT=15051
QDRANT_REST_PORT=16333
QDRANT_PORT=16334
MILVUS_PORT=19531
MILVUS_HEALTH_PORT=19091
OPENSEARCH_PORT=19200
SEARXNG_PORT=18888
DEX_PORT=15556
DOCREADER_IMAGE=weknora-agent-eval-docreader:local

WEKNORA_RUNTIME_PROJECT_NAME=weknora-agent-eval-runtime
WEKNORA_RUNTIME_CONTAINER_PREFIX=weknora-agent-eval-runtime
WEKNORA_RUNTIME_IMAGE=weknora-agent-eval-runtime:local
WEKNORA_RUNTIME_BASE_IMAGE=weknora-agent-eval-dev-app:local
WEKNORA_RUNTIME_DOCREADER_IMAGE=weknora-agent-eval-docreader:local
WEKNORA_RUNTIME_NETWORK_NAME=weknora-agent-eval-network
WEKNORA_RUNTIME_GO_MOD_CACHE_NAME=weknora-agent-eval-go-mod-cache
WEKNORA_RUNTIME_API_PORT=18080
# The eval database is a physical/logical clone of the main development data.
# Its schema version can be newer than this worktree's migration bundle, so the
# native migrator must stay off. The dedicated role still runs custom migrations.
WEKNORA_RUNTIME_NATIVE_AUTO_MIGRATE=false
WEKNORA_RUNTIME_ENV_FILE=C:/weknora/.env

CUSTOM_GENERAL_AGENT_PROJECT_NAME=weknora-agent-eval-agents
CUSTOM_GENERAL_AGENT_CONTAINER_NAME=weknora-agent-eval-general-agent
CUSTOM_DOCUMENT_PROCESSING_AGENT_CONTAINER_NAME=weknora-agent-eval-document-processing-agent
CUSTOM_GENERAL_AGENT_IMAGE=weknora-agent-eval-general-agent:local
CUSTOM_DOCUMENT_PROCESSING_AGENT_IMAGE=weknora-agent-eval-document-processing-agent:local
CUSTOM_GENERAL_AGENT_PORT_BIND=127.0.0.1:18091
CUSTOM_DOCUMENT_PROCESSING_AGENT_PORT_BIND=127.0.0.1:18093
CUSTOM_GENERAL_AGENT_NETWORK=weknora-agent-eval-network
# Eval may perform one same-session evidence continuation and one isolated,
# tool-free terminal rewrite. Main/production defaults this to 0 (record-only).
CUSTOM_GENERAL_AGENT_EVAL_BLOCKING_REPAIR=1
# Bound pathological provider output in the isolated Eval environment. The
# production Compose default remains 8192 and is unaffected by this override.
CUSTOM_GENERAL_AGENT_CLAUDE_MAX_OUTPUT_TOKENS=4096

CUSTOM_AGENT_EVAL_MODE=eval
CUSTOM_AGENT_EVAL_CAPTURE_POLICY=full
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://weknora-agent-eval-langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-weknora-agent-eval-local
LANGFUSE_SECRET_KEY=sk-lf-weknora-agent-eval-local
LANGFUSE_ENVIRONMENT=agent-eval
LANGFUSE_RELEASE=codex-agent-eval-framework
LANGFUSE_SAMPLE_RATE=1

AGENT_EVAL_LANGFUSE_WEB_PORT=13001
