{
  "schema_version": 1,
  "policy_id": "weknora-three-agent-multiturn-optimization-gate-v1",
  "required_splits": ["dev"],
  "required_capabilities": [
    "rag_retrieval",
    "long_context_dialogue",
    "citation"
  ],
  "required_agent_profiles": [
    "quick-answer",
    "rag-reasoning",
    "general-agent"
  ],
  "min_repetitions_per_case": 3,
  "min_case_coverage": 1.0,
  "max_invalid_rate": 0.0,
  "forbid_hard_failures": false,
  "forbid_pass_to_fail_regressions": true,
  "pair_repetitions_by_attempt": false,
  "min_pass_rate_per_case": 1.0,
  "max_case_pass_rate_regression": 0.0,
  "critical_metric_prefixes": [
    "execution_valid",
    "citation_integrity",
    "evidence_anchor_coverage",
    "read_only_tool_policy",
    "tool_call_ceiling",
    "response_max_length",
    "state.action_boundary",
    "forbidden_claim.no-internal-planning"
  ],
  "require_judge": true,
  "min_judge_confidence": 0.85,
  "judge_reviewable_metric_prefixes": [
    "required_claim",
    "state.active",
    "state.retired",
    "state.unknown",
    "state.lifecycle",
    "state.section_structure",
    "state.forbidden_inference",
    "state.forbidden_unknown",
    "decision.required_unknown",
    "decision.required_defer"
  ],
  "max_metric_rate_regression": {
    "execution_valid": 0.0,
    "citation_integrity": 0.0,
    "evidence_anchor_coverage": 0.0,
    "tool_call_ceiling": 0.0,
    "read_only_tool_policy": 0.0,
    "forbidden_claim.no-internal-planning": 0.0
  },
  "required_frozen_dependencies": [
    "scorer",
    "gate",
    "judge",
    "calibrator"
  ],
  "required_execution_identity_fields": [
    "summary_model_id",
    "corpus_version",
    "procurement_knowledge_id",
    "profile_set_sha256",
    "framework_commit",
    "framework_worktree_dirty",
    "scorer_sha256",
    "judge_model",
    "judge_calibration_suite_sha256",
    "judge_prompt_sha256",
    "judge_protocol",
    "judge_timeout_seconds",
    "judge_max_attempts",
    "response_deadline_seconds"
  ],
  "require_clean_framework": true,
  "required_sut_identity_fields": [
    "commit",
    "raw.worktree_dirty",
    "raw.runtime_image_id",
    "raw.general_agent_image_id"
  ],
  "require_clean_sut": true,
  "max_p95_latency_regression_ratio": 0.15,
  "max_p95_latency_regression_ms": 500,
  "max_p95_latency_ms_by_agent": {
    "quick-answer": 30000,
    "rag-reasoning": 60000,
    "general-agent": 120000
  },
  "max_latency_ms_by_agent": {
    "quick-answer": 60000,
    "rag-reasoning": 120000,
    "general-agent": 180000
  },
  "require_baseline": true
}
