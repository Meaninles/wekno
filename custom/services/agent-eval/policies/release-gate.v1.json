{
  "schema_version": 1,
  "policy_id": "weknora-agent-release-gate-v1",
  "required_splits": ["gate"],
  "required_capabilities": [
    "rag_retrieval",
    "document_processing",
    "long_context_dialogue"
  ],
  "min_case_coverage": 1.0,
  "max_invalid_rate": 0.0,
  "forbid_hard_failures": true,
  "forbid_pass_to_fail_regressions": true,
  "max_metric_rate_regression": {
    "citation_integrity": 0.0,
    "evidence_anchor_coverage": 0.0,
    "no_stale_citations": 0.0,
    "read_only_tool_policy": 0.0
  },
  "max_p95_latency_regression_ratio": 0.15,
  "max_p95_latency_regression_ms": 500,
  "require_baseline": true
}
