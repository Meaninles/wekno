{
  "schema_version": 1,
  "profile_set_id": "weknora-multiturn-agents-v1",
  "scope": "Only the three built-in WeKnora conversation agents are in scope.",
  "model": {
    "environment_variable": "AGENT_EVAL_SUMMARY_MODEL_ID",
    "required_model_id": "prod-deepseek-v4-flash-int8-chat",
    "display_name": "DeepSeek V4 Flash"
  },
  "execution_contract": {
    "mode": "codex-operated-staged-eval",
    "discovery_mode": "codex-led-adaptive-discovery",
    "max_unreviewed_turns": 1,
    "formal_scoring_enabled": true,
    "formal_scoring_scope": "frozen dev/gate/sealed datasets only",
    "failed_attempt_policy": "quarantine-and-rollback-request-pair",
    "gold_answer_policy": "observed assistant answers are provenance only, never automatic gold answers"
  },
  "profiles": [
    {
      "profile_id": "quick-answer",
      "display_name": "快速问答",
      "agent_id": "builtin-quick-answer",
      "agent_type": "rag-qa",
      "endpoint": "knowledge-chat",
      "configured_history_turns": 5,
      "minimum_discovery_turns": 7,
      "planned_discovery_turns": 12,
      "knowledge_ids": ["${AGENT_EVAL_PROCUREMENT_KNOWLEDGE_ID}"],
      "required_problem_families": [
        "retrieval-recall",
        "citation-grounding",
        "state-supersession",
        "hallucinated-user-fact",
        "history-window-overflow"
      ]
    },
    {
      "profile_id": "rag-reasoning",
      "display_name": "RAG推理",
      "agent_id": "builtin-smart-reasoning",
      "agent_type": "rag-qa",
      "endpoint": "agent-chat",
      "configured_history_turns": 10,
      "minimum_discovery_turns": 12,
      "planned_discovery_turns": 12,
      "knowledge_ids": ["${AGENT_EVAL_PROCUREMENT_KNOWLEDGE_ID}"],
      "required_problem_families": [
        "retrieval-recall",
        "citation-grounding",
        "reasoning-consistency",
        "state-supersession",
        "history-window-overflow",
        "tool-failure-isolation"
      ]
    },
    {
      "profile_id": "general-agent",
      "display_name": "通用智能体",
      "agent_id": "builtin-general-agent",
      "agent_type": "general-agent",
      "endpoint": "agent-chat",
      "configured_history_turns": 10,
      "minimum_discovery_turns": 12,
      "planned_discovery_turns": 12,
      "knowledge_ids": ["${AGENT_EVAL_PROCUREMENT_KNOWLEDGE_ID}"],
      "required_problem_families": [
        "retrieval-recall",
        "citation-grounding",
        "reasoning-consistency",
        "state-supersession",
        "action-boundary",
        "history-window-overflow",
        "tool-failure-isolation",
        "latency-tail"
      ]
    }
  ]
}
