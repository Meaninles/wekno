# Copy to a private environment file or export these variables before using
# docker compose. Never commit real credentials.
LITELLM_LOCAL_PORT=14000
LITELLM_MASTER_KEY=replace-with-a-local-master-key
LITELLM_SALT_KEY=replace-with-a-stable-local-salt
LITELLM_DATABASE_URL=postgresql://user:password@postgres:5432/litellm
REDIS_PASSWORD=replace-with-the-local-weknora-redis-password
UPSTREAM_KEY_QWEN27B_TOOL=replace-with-the-production-upstream-key
DRAIN_TOKEN=replace-with-a-local-drain-token
