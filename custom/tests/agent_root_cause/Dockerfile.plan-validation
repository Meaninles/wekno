FROM weknora-dev-app:local AS checks
WORKDIR /workspace
COPY . .
COPY custom/tests/agent_root_cause/plan_validation_manager.go.txt internal/custom/modules/kbmanager/plan_validation_test.go
COPY custom/tests/agent_root_cause/plan_validation_wiki.go.txt internal/agent/tools/plan_validation_test.go
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/.cache/go-mod \
    mkdir -p /out && GOMODCACHE=/root/.cache/go-mod /usr/local/go/bin/go test -p 1 \
    -ldflags="-X google.golang.org/protobuf/reflect/protoregistry.conflictPolicy=warn" \
    -run '^TestPlanValidation' -count=1 -v ./internal/custom/modules/kbmanager ./internal/agent/tools \
    > /out/components.log 2>&1 || (cat /out/components.log && exit 1)
FROM scratch AS results
COPY --from=checks /out/ /
