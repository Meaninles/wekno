FROM weknora-dev-app:local AS checks
WORKDIR /workspace
COPY . .
COPY custom/tests/agent_root_cause/remaining_chunk_config.go.txt internal/application/service/remaining_chunk_config_test.go
COPY custom/tests/agent_root_cause/remaining_citation.go.txt internal/custom/modules/generalagent/remaining_citation_test.go
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/.cache/go-mod \
    mkdir -p /out && GOMODCACHE=/root/.cache/go-mod /usr/local/go/bin/go test -p 1 \
    -ldflags="-X google.golang.org/protobuf/reflect/protoregistry.conflictPolicy=warn" \
    -run '^TestRemaining' -count=1 -v ./internal/application/service ./internal/custom/modules/generalagent \
    > /out/remaining-components.log 2>&1 || (cat /out/remaining-components.log && exit 1)
FROM scratch AS results
COPY --from=checks /out/ /
